{
  "TargetConnectionString": "Host=<clickhouse-host>;Port=8123;Protocol=http;Database=<target-database>;Username=<user>;Password=<password>",
  "Connections": [
    {
      "Name": "example_postgres",
      "Type": "Postgres",
      "ConnectionString": "Host=<postgres-host>;Port=5432;Database=<database>;Username=<user>;Password=<password>"
    },
    {
      "Name": "example_sqlserver",
      "Type": "SqlServer",
      "ConnectionString": "Server=<sqlserver-host>,1433;Database=<database>;User Id=<user>;Password=<password>;TrustServerCertificate=True;Encrypt=False"
    },
    {
      "Name": "example_clickhouse",
      "Type": "ClickHouse",
      "ConnectionString": "Host=<clickhouse-host>;Port=8123;Protocol=http;Database=<database>;Username=<user>;Password=<password>"
    },
    {
      "Name": "example_hive_jdbc",
      "Type": "Jdbc",
      "ConnectionString": "JarPath=<path-to-hive-jdbc-classpath-dir>;DriverClass=org.apache.hive.jdbc.HiveDriver;JdbcUrl=jdbc:hive2://<hive-host>:10000/<database>;User=<user>;Password=<password>"
    },
    {
      "Name": "example_kyuubi_jdbc",
      "Type": "Jdbc",
      "ConnectionString": "JarPath=<path-to-kyuubi-hive-jdbc-shaded-1.9.0.jar>;DriverClass=org.apache.kyuubi.jdbc.KyuubiHiveDriver;JdbcUrl=jdbc:kyuubi://<kyuubi-host>:10009/<database>;User=<user>;Password=<password>"
    }
  ],
  "PixBi": {
    "Enabled": false,
    "BaseUri": "https://<pix-bi-host>",
    "Username": "<username>",
    "Password": "<password>",
    "PageSize": 50
  }
}
